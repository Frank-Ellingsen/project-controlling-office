# =============================================================================
# ELKEM PROJECT CONTROLLER - SYSTEM CONFIGURATION (.env)
# =============================================================================

# --- API-nøkler ---
MINI_API_KEY=AQ.Ab
SERPER_API_KEY=d6f07f
GEMINI_API_KEY=

# --- Ollama Konfigurasjon ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- LLM Modellvalg ---
OLLAMA_MODEL=llama3.1
GEMINI_MODEL=gemini-3.8-flash    # Rask og rimelig modell til OCR, PDF-analyse og multimodale oppgaver

# --- Embedding Modell (Vektordatabase / RAG) ---
EMBEDDING_PROVIDER=ollama         # 'ollama' eller 'huggingface'
EMBEDDING_MODEL=nomic-embed-text  # Kjøres lokalt via Ollama

# --- App Systemvariabler ---
LOG_LEVEL=INFO
ENVIRONMENT=development
KUNNSKAPSBASERE_PATH=/app/data/kunnskapsbase
QDRANT_HOST=qdrant
QDRANT_PORT=6333
